{
  "name": "leakwatch",
  "displayName": "Leakwatch",
  "description": "Detect leaked secrets in your code with Leakwatch",
  "version": "0.1.0",
  "publisher": "HodeTech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HodeTech/Leakwatch",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "secrets",
    "leak",
    "scanner",
    "api-keys"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Leakwatch runs an external binary; in untrusted workspaces scanning is disabled and the executable/config paths cannot be overridden by workspace settings.",
      "restrictedConfigurations": [
        "leakwatch.executablePath",
        "leakwatch.customRulesPath"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "leakwatch.scanWorkspace",
        "title": "Leakwatch: Scan Workspace"
      },
      {
        "command": "leakwatch.scanCurrentFile",
        "title": "Leakwatch: Scan Current File"
      },
      {
        "command": "leakwatch.clearDiagnostics",
        "title": "Leakwatch: Clear Diagnostics"
      }
    ],
    "configuration": {
      "title": "Leakwatch",
      "properties": {
        "leakwatch.executablePath": {
          "type": "string",
          "default": "leakwatch",
          "scope": "machine-overridable",
          "description": "Path to the leakwatch binary. For security this cannot be set by workspace settings."
        },
        "leakwatch.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files on save"
        },
        "leakwatch.minSeverity": {
          "type": "string",
          "default": "low",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Minimum severity level to report"
        },
        "leakwatch.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline hints for detected secrets"
        },
        "leakwatch.scanTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Maximum time (in milliseconds) a scan may run before it is aborted. Increase for large repositories."
        },
        "leakwatch.maxBufferMb": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Maximum size (in megabytes) of scan output to buffer. Increase if scans of large repositories exceed the limit."
        },
        "leakwatch.customRulesPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to a leakwatch config file passed as --config. Note: this overrides the entire .leakwatch.yaml config, not only custom rules. For security this cannot be set by workspace settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src",
    "pretest": "tsc -p ./",
    "test": "node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
